+def _skive_can_compact(kv_cache_spec) -> bool:  # SKIVE: multi-group (gpt-oss)
+    """Only the full-attention KV group may be sparse-gathered. Sliding-window
+    groups (gpt-oss even layers) already hold vLLM's own null blocks for
